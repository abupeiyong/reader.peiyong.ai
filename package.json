{
  "name": "reader-peiyong-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy -c dist/reader_peiyong_ai/wrangler.json",
    "db:migrate:local": "wrangler d1 migrations apply reader-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply reader-db --remote",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "copy:pdfjs": "rm -rf public/standard_fonts public/cmaps && cp -r node_modules/pdfjs-dist/standard_fonts node_modules/pdfjs-dist/cmaps public/",
    "predev": "npm run copy:pdfjs",
    "prebuild": "npm run copy:pdfjs"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260714.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.61.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
