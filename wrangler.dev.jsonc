// 本地开发配置:不含 Workers AI 绑定(AI 绑定必须连 Cloudflare 远程,需要 wrangler login)。
// 代码在 env.AI 缺失时自动回退到离线 mock。部署用根目录 wrangler.jsonc。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reader-peiyong-ai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reader-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "reader-files"
    }
  ],
  "vars": {
    "APP_ENV": "dev",
    "APP_ORIGIN": "http://localhost:5173",
    // Hadi 小程序登录的本地自测:scripts/hadi-e2e.mjs 会在 4174 起一个假 hub 来签令牌
    "HADI_HUB_URL": "http://127.0.0.1:4174",
    "HADI_APP_ID": "reader"
  }
}
